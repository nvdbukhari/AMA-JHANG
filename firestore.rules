rules_version = '2';
// AmC Installment App — production-oriented starter rules
// For multi-shop: add shopId field on every document and enforce request.auth + shop membership.
// Current app uses shared shop with admin/recovery users stored in /users.
//
// DEV (open — only for testing):
// match /{document=**} { allow read, write: if true; }
//
// RECOMMENDED (after Firebase Auth is added):
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Temporary shop mode: allow all authenticated clients.
    // Replace with custom claims (role/shopId) when Auth is integrated.
    match /users/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /products/{id} {
      allow read, write: if true;
    }
    match /purchases/{id} {
      allow read, write: if true;
    }
    match /invoices/{id} {
      allow read, write: if true;
    }
    match /agreements/{id} {
      allow read, write: if true;
    }
  }
}

// Composite indexes you may need in Firebase Console:
// invoices: recoveryManId ASC, invoiceDate DESC
// invoices: status ASC, invoiceDate DESC
// invoices: recoveryManId ASC, status ASC, invoiceDate DESC
// invoices: customerCnic ASC, invoiceDate DESC
